{
  "info": {
    "_postman_id": "f7a801ab-0b53-41dc-9fd0-25c85e77524c",
    "name": "BookNest - Open Library API",
    "description": "Requests used by the BookNest lab 4 API integration. The work and editions requests can be run independently or in parallel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Search books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://{{baseUrl}}/search.json?q=clean%20code&page=1&limit=20&fields=key%2Ctitle%2Cauthor_name%2Cfirst_publish_year%2Csubject%2Ccover_i%2Cratings_average",
          "protocol": "https",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search.json"
          ],
          "query": [
            {
              "key": "q",
              "value": "clean code"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "fields",
              "value": "key,title,author_name,first_publish_year,subject,cover_i,ratings_average"
            }
          ]
        }
      }
    },
    {
      "name": "Get work details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://{{baseUrl}}/works/{{workId}}.json",
          "protocol": "https",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "works",
            "{{workId}}.json"
          ]
        }
      }
    },
    {
      "name": "Get work editions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://{{baseUrl}}/works/{{workId}}/editions.json?limit=1",
          "protocol": "https",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "works",
            "{{workId}}",
            "editions.json"
          ],
          "query": [
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "openlibrary.org"
    },
    {
      "key": "workId",
      "value": "OL45804W"
    }
  ]
}
